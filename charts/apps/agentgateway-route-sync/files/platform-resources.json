    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "devai-ai-observability",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "ai-gateway"
          }
        ],
        "frontend": {
          "accessLog": {
            "attributes": {
              "add": [
                {
                  "name": "devai.tenant_id",
                  "expression": "\"x-devai-tenant-id\" in request.headers ? request.headers[\"x-devai-tenant-id\"] : \"\""
                },
                {
                  "name": "devai.user_id",
                  "expression": "\"x-devai-user-id\" in request.headers ? request.headers[\"x-devai-user-id\"] : \"\""
                },
                {
                  "name": "devai.run_id",
                  "expression": "\"x-devai-run-id\" in request.headers ? request.headers[\"x-devai-run-id\"] : \"\""
                },
                {
                  "name": "devai.agent",
                  "expression": "\"x-devai-agent\" in request.headers ? request.headers[\"x-devai-agent\"] : \"\""
                },
                {
                  "name": "devai.provider",
                  "expression": "\"x-devai-provider\" in request.headers ? request.headers[\"x-devai-provider\"] : \"\""
                }
              ]
            }
          },
          "tracing": {
            "backendRef": {
              "kind": "Service",
              "name": "ai-usage-ingest",
              "namespace": "tesserix",
              "port": 4318
            },
            "protocol": "HTTP",
            "path": "/v1/traces",
            "clientSampling": "1.0",
            "randomSampling": "1.0",
            "attributes": {
              "add": [
                {
                  "name": "tesserix.product",
                  "expression": "'devai'"
                },
                {
                  "name": "tesserix.gateway",
                  "expression": "'ai-gateway'"
                },
                {
                  "name": "tesserix.capability",
                  "expression": "\"x-devai-agent\" in request.headers ? request.headers[\"x-devai-agent\"] : \"\""
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "devai-ai-routes",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "devai-ai"
          }
        ],
        "backend": {
          "ai": {
            "routes": {
              "/v1/chat/completions": "Completions",
              "/v1/embeddings": "Embeddings",
              "/v1/messages": "Messages",
              "/v1/messages/count_tokens": "AnthropicTokenCount",
              "/v1/models": "Models",
