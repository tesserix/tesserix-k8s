    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "ai-public-oauth",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "ai-gateway",
            "sectionName": "public"
          }
        ],
        "traffic": {
          "jwtAuthentication": {
            "mode": "Strict",
            "providers": [
              {
                "issuer": "https://auth.tesserix.app",
                "audiences": [
                  "387190457387450503"
                ],
                "jwks": {
                  "remote": {
                    "jwksPath": "/oauth/v2/keys",
                    "cacheDuration": "15m",
                    "backendRef": {
                      "group": "agentgateway.dev",
                      "kind": "AgentgatewayBackend",
                      "name": "ai-zitadel-jwks",
                      "port": 443
                    }
                  }
                }
              }
            ]
          },
          "authorization": {
            "action": "Allow",
            "policy": {
              "matchExpressions": [
                "\"agentgateway.models\" in jwt[\"urn:zitadel:iam:org:project:387190457387450503:roles\"]"
              ]
            }
          },
          "rateLimit": {
            "global": {
              "backendRef": {
                "name": "agentgateway-ratelimit",
                "port": 8081
              },
              "domain": "agentgateway-public",
              "failureMode": "FailClosed",
              "descriptors": [
                {
                  "entries": [
                    {
                      "name": "gateway",
                      "expression": "\"models\""
                    },
                    {
                      "name": "oauth_subject",
                      "expression": "jwt.sub"
                    }
                  ],
                  "unit": "Requests"
                },
                {
                  "entries": [
                    {
                      "name": "oauth_subject_tokens",
                      "expression": "jwt.sub"
                    }
                  ],
                  "unit": "Tokens"
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "ai-public-observability",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "ai-gateway",
            "sectionName": "public"
          }
        ],
        "frontend": {
          "accessLog": {
            "attributes": {
              "add": [
