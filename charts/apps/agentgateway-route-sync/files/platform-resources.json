      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-a2a"
          }
        ],
        "traffic": {
          "jwtAuthentication": {
            "mode": "Strict",
            "location": {
              "header": {
                "name": "X-Kora-End-User-Token",
                "prefix": "Bearer "
              }
            },
            "providers": [
              {
                "issuer": "https://securetoken.google.com/kora-app-e6d38",
                "audiences": [
                  "kora-app-e6d38"
                ],
                "jwks": {
                  "remote": {
                    "jwksPath": "/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com",
                    "cacheDuration": "5m",
                    "backendRef": {
                      "group": "agentgateway.dev",
                      "kind": "AgentgatewayBackend",
                      "name": "kora-firebase-jwks",
                      "port": 443
                    }
                  }
                }
              }
            ]
          },
          "transformation": {
            "request": {
              "set": [
                {
                  "name": "X-Kora-Delegated-End-User-Token",
                  "value": "\"x-kora-end-user-token\" in request.headers ? request.headers[\"x-kora-end-user-token\"] : \"\""
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "kora-ai-guardrails",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-ai"
          }
        ],
        "backend": {
          "ai": {
            "promptGuard": {
              "request": [
                {
                  "regex": {
                    "action": "Reject",
                    "builtins": [
                      "CreditCard",
                      "Ssn"
                    ]
                  },
                  "response": {
                    "message": "Request rejected by the Kora AI data policy",
                    "statusCode": 400
                  }
                },
                {
                  "regex": {
                    "action": "Mask",
                    "builtins": [
                      "Email",
                      "PhoneNumber"
                    ]
                  }
                },
                {
                  "regex": {
                    "action": "Reject",
                    "matches": [
                      "(?i)\\b(ignore|disregard)\\s+(all\\s+)?(previous|prior|system|developer)\\s+instructions?\\b",
                      "(?i)\\b(reveal|print|show)\\s+(the\\s+)?(system|developer)\\s+prompt\\b"
                    ]
                  },
                  "response": {
                    "message": "Request rejected by the Kora AI instruction policy",
                    "statusCode": 400
                  }
                }
              ],
              "response": [
                {
                  "regex": {
                    "action": "Mask",
                    "builtins": [
                      "CreditCard",
                      "Email",
                      "PhoneNumber",
                      "Ssn"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "kora-ai-observability",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "kora-ai"
          }
        ],
        "frontend": {
          "http": {
            "maxBufferSize": "16Mi"
          },
          "metrics": {
            "attributes": {
              "add": [
                {
                  "name": "kora.ai.capability",
                  "expression": "\"x-kora-ai-capability\" in request.headers ? request.headers[\"x-kora-ai-capability\"] : \"\""
                },
                {
                  "name": "kora.ai.context_kind",
                  "expression": "\"x-kora-ai-context-kind\" in request.headers ? request.headers[\"x-kora-ai-context-kind\"] : \"\""
                }
              ]
            }
          },
          "tracing": {
            "backendRef": {
              "kind": "Service",
              "name": "ai-usage-ingest",
              "namespace": "tesserix",
              "port": 4318
            },
            "protocol": "HTTP",
            "path": "/v1/traces",
            "clientSampling": "1.0",
            "randomSampling": "1.0",
            "attributes": {
              "add": [
                {
                  "name": "tesserix.product",
                  "expression": "'kora'"
                },
                {
                  "name": "tesserix.gateway",
                  "expression": "'kora-ai'"
                },
                {
                  "name": "tesserix.capability",
                  "expression": "\"x-kora-ai-capability\" in request.headers ? request.headers[\"x-kora-ai-capability\"] : \"\""
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "kora-ai-traffic",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-ai"
          }
        ],
        "traffic": {
          "apiKeyAuthentication": {
            "mode": "Strict",
            "secretRef": {
              "name": "kora-ai-gateway-client-credentials"
            }
          },
          "rateLimit": {
            "local": [
              {
                "requests": 120,
                "unit": "Minutes",
                "burst": 20
              },
              {
                "tokens": 1000000,
                "unit": "Hours"
              }
            ]
          },
          "timeouts": {
            "request": "120s"
          },
          "extProc": {
            "backendRef": {
              "name": "token-optimizer",
              "port": 18080
            },
            "failureMode": "FailOpen",
            "requestAttributes": {
              "token_optimizer.capability": "\"x-kora-ai-capability\" in request.headers ? request.headers[\"x-kora-ai-capability\"] : \"\"",
              "token_optimizer.context_kind": "\"x-kora-ai-context-kind\" in request.headers ? request.headers[\"x-kora-ai-context-kind\"] : \"\"",
              "token_optimizer.rtk_applied": "\"x-kora-rtk-applied\" in request.headers ? request.headers[\"x-kora-rtk-applied\"] == \"true\" : false"
            },
            "processingOptions": {
              "requestBodyMode": "Buffered",
              "responseBodyMode": "None"
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "kora-user-auth",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-ai",
            "sectionName": "conversation"
          },
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-ai",
            "sectionName": "structured"
          },
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "kora-ai",
            "sectionName": "default"
          }
        ],
        "traffic": {
          "jwtAuthentication": {
            "mode": "Strict",
            "location": {
              "header": {
                "name": "X-Kora-End-User-Token",
                "prefix": "Bearer "
              }
            },
            "providers": [
              {
                "issuer": "https://securetoken.google.com/kora-app-e6d38",
                "audiences": [
                  "kora-app-e6d38"
                ],
                "jwks": {
                  "remote": {
                    "jwksPath": "/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com",
                    "cacheDuration": "5m",
                    "backendRef": {
                      "group": "agentgateway.dev",
                      "kind": "AgentgatewayBackend",
                      "name": "kora-firebase-jwks",
                      "port": 443
                    }
                  }
                }
              }
            ]
          },
          "transformation": {
            "request": {
              "remove": [
                "X-Kora-End-User-Token",
                "X-Kora-Delegated-End-User-Token"
              ]
            }
          }
        }
      }
    },
    {
