    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {
        "name": "kora-ai",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "parentRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "kora-ai",
            "sectionName": "http"
          }
        ],
        "rules": [
          {
            "name": "embedding",
            "matches": [
              {
                "path": {
                  "type": "PathPrefix",
                  "value": "/"
                },
                "headers": [
                  {
                    "name": "x-kora-ai-capability",
                    "type": "Exact",
                    "value": "embedding"
                  }
                ]
              }
            ],
            "filters": [
              {
                "type": "RequestHeaderModifier",
                "requestHeaderModifier": {
                  "remove": [
                    "X-Kora-End-User-Token",
                    "X-Kora-Delegated-End-User-Token"
                  ]
                }
              }
            ],
            "backendRefs": [
              {
                "group": "agentgateway.dev",
                "kind": "AgentgatewayBackend",
                "name": "kora-embedding-providers",
                "weight": 1
              }
            ]
          },
          {
            "name": "conversation",
            "matches": [
              {
                "path": {
                  "type": "PathPrefix",
                  "value": "/"
                },
                "headers": [
                  {
                    "name": "x-kora-ai-context-kind",
                    "type": "Exact",
                    "value": "conversation"
                  }
                ]
              }
            ],
            "backendRefs": [
              {
                "group": "agentgateway.dev",
                "kind": "AgentgatewayBackend",
                "name": "kora-conversation-providers",
                "weight": 1
              }
            ]
          },
          {
            "name": "structured",
            "matches": [
              {
                "path": {
                  "type": "PathPrefix",
                  "value": "/"
                },
                "headers": [
                  {
                    "name": "x-kora-ai-context-kind",
                    "type": "Exact",
                    "value": "json_api"
                  }
                ]
              }
            ],
            "backendRefs": [
              {
                "group": "agentgateway.dev",
                "kind": "AgentgatewayBackend",
                "name": "kora-structured-providers",
                "weight": 1
              }
            ]
          },
          {
            "name": "default",
            "matches": [
              {
                "path": {
                  "type": "PathPrefix",
                  "value": "/"
                }
              }
            ],
            "backendRefs": [
              {
                "group": "agentgateway.dev",
                "kind": "AgentgatewayBackend",
                "name": "kora-structured-providers",
                "weight": 1
              }
            ]
          }
        ]
      }
