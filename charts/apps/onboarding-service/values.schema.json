{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "helivantaFeatureCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "policy_version",
            "capabilities"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "owner",
                  "eligible",
                  "dependencies"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]{0,63}$"
                  },
                  "owner": {
                    "type": "string",
                    "enum": [
                      "platform",
                      "workforce",
                      "pharmacy"
                    ]
                  },
                  "eligible": {
                    "type": "boolean"
                  },
                  "dependencies": {
                    "type": "array",
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z_]{0,63}$"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "catalogue"
            ]
          }
        }
      ]
    }
  }
}
