    {
      "id": 8,
      "type": "row",
      "title": "AI Agents \u00b7 Fleet",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
