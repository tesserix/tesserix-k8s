{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
        "condition": { "age": 7, "matchesStorageClass": ["STANDARD"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 37 }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "isLive": false, "daysSinceNoncurrentTime": 7 }
      },
      {
        "action": { "type": "AbortIncompleteMultipartUpload" },
        "condition": { "age": 3 }
      }
    ]
  }
}
