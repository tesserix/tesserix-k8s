{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": {
          "age": 10,
          "matchesPrefix": [
            "devai-postgres/",
            "dwellm8-postgres/",
            "dwellm8-temporal-postgres/",
            "fanzone-postgres/",
            "gameverse-postgres/",
            "global-postgres/",
            "guardix-postgres/",
            "homechef-postgres/",
            "homechef-temporal-postgres/",
            "horoscope-postgres/",
            "infra-postgres/",
            "mark8ly-postgres/",
            "planning-poker-postgres/",
            "postiz-postgres/",
            "postsocial-postgres/",
            "social-postgres/",
            "stockpilot-postgres/",
            "support-platform-postgres/",
            "tesserix-postgres/",
            "zitadel-postgres/"
          ]
        }
      },
      {
        "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
        "condition": {
          "age": 7,
          "matchesStorageClass": ["STANDARD"],
          "matchesPrefix": ["openbao/", "homechef-mongodb/"]
        }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 37 }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "isLive": false, "daysSinceNoncurrentTime": 7 }
      },
      {
        "action": { "type": "AbortIncompleteMultipartUpload" },
        "condition": { "age": 3 }
      }
    ]
  }
}
