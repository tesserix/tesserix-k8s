# =============================================================================
# Terraform .gitignore
# =============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files (state is stored in GCS)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
# Note: We keep environments/*.tfvars as they don't contain secrets
# *.tfvars
# *.tfvars.json

# Ignore override files (used for local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plan output files
*.tfplan
*.plan

# Terraform debug/trace logs
*.log

# macOS
.DS_Store

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# Sensitive files that might be created locally
*.pem
*.key
*credentials*
*.secret
*.secret.*
secrets.local.*
!stacks/*/.terraform.lock.hcl

# Temp files
*.tmp
*.temp
*.bak
bootstrap-captures/

# =============================================================================
# Files to KEEP (do not ignore):
# - .terraform.lock.hcl (provider lock file - should be committed)
# - environments/*/terraform.tfvars (environment configs without secrets)
# =============================================================================
