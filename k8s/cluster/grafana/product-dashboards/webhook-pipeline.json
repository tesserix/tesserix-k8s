{
  "uid": "webhook-pipeline-v1",
  "title": "Webhook Pipeline",
  "description": "Webhook ingress throughput + HTTP-level health. Latency histograms (p50/p95/p99) and orphan-queue panels from the plan are deferred: webhook_processing_duration_seconds_bucket and webhook_orphan_* collectors are not yet registered in marketplace-api. Once shipped (P8 successor round) this dashboard gains the histogram panels in-place.",
  "tags": [
    "subscription",
    "webhook",
    "ops",
    "mark8ly"
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "tenant",
        "label": "Tenant (placeholder)",
        "description": "Placeholder \u2014 webhook_received_total has no tenant_id label yet.",
        "type": "custom",
        "query": "all",
        "current": {
          "selected": true,
          "text": "all",
          "value": "all"
        },
        "includeAll": true,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Subscription Health",
      "url": "/d/subscription-health-v1",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Trial Activation Funnel",
      "url": "/d/trial-funnel-v1",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 4,
      "title": "HTTP 5xx rate (full service)",
      "type": "timeseries",
      "description": "http:error_rate:ratio5m \u2014 includes webhook endpoint failures. A spike here usually means the Stripe webhook handler is 5xx-ing; Stripe will retry at >10s.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "http:error_rate:ratio5m",
          "refId": "A",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.03
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Outbox events published \u2014 5m rate",
      "type": "timeseries",
      "description": "rate(outbox_events_published_total[5m]). Tracks outbound event throughput; a flatline alongside live traffic indicates the outbox drainer stalled.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "outbox:published:rate5m",
          "refId": "A",
          "legendFormat": "published/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Outbox pending depth",
      "type": "timeseries",
      "description": "outbox_events_pending gauge. Sustained non-zero values indicate publish lag.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "outbox_events_pending",
          "refId": "A",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "HTTP requests by status class",
      "type": "timeseries",
      "description": "http:requests:rate5m split by HTTP status class. Useful next to the error-rate ratio for absolute scale.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "http:requests:rate5m",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
