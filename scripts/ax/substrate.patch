+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestEnsureSecretDoesNotOverwriteExistingKeys(t *testing.T) {
+	t.Parallel()
+	stored := false
+	writes := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Vault-Token") != "test-token" {
+			t.Error("missing authentication")
+		}
+		if !strings.HasPrefix(r.URL.Path, "/v1/kv/data/ax-system/production/ax-") {
+			t.Error("secret escaped product path")
+		}
+		switch r.Method {
+		case "GET":
+			if !stored {
+				w.WriteHeader(404)
+			} else {
+				w.WriteHeader(200)
+			}
+		case "POST":
+			var body struct {
+				Options struct {
+					CAS int `json:"cas"`
+				} `json:"options"`
+				Data map[string]string `json:"data"`
+			}
+			if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+				t.Error(err)
+			}
+			if body.Options.CAS != 0 || body.Data["password"] != "test-value" {
+				t.Error("write must be create-only")
+			}
+			writes++
+			stored = true
+			w.WriteHeader(200)
+		default:
+			t.Error("unexpected method")
+		}
+	}))
+	t.Cleanup(server.Close)
+	client := &baoClient{base: server.URL, token: "test-token", http: server.Client()}
+	for i := 0; i < 2; i++ {
+		if err := client.ensure(t.Context(), "ax-test", func() (map[string]string, error) { return map[string]string{"password": "test-value"}, nil }); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if writes != 1 {
+		t.Fatalf("writes=%d; want 1", writes)
+	}
+}
