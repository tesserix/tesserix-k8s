+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"os"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/localca"
+	"github.com/agent-substrate/substrate/internal/localjwtauthority"
+)
+
+type baoClient struct {
+	base, token string
+	http        *http.Client
+}
+
+func (c *baoClient) request(ctx context.Context, method, path string, body any) ([]byte, int, error) {
+	var data []byte
+	var err error
+	if body != nil {
+		data, err = json.Marshal(body)
+		if err != nil {
+			return nil, 0, err
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.base+"/v1/"+path, bytes.NewReader(data))
+	if err != nil {
+		return nil, 0, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if c.token != "" {
+		req.Header.Set("X-Vault-Token", c.token)
+	}
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, 0, fmt.Errorf("OpenBao request: %w", err)
+	}
+	defer resp.Body.Close()
+	data, err = io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	return data, resp.StatusCode, err
+}
+
+func (c *baoClient) ensure(ctx context.Context, name string, generate func() (map[string]string, error)) error {
+	path := "kv/data/ax-system/production/" + name
+	_, status, err := c.request(ctx, "GET", path, nil)
+	if err != nil {
+		return err
+	}
+	if status == http.StatusOK {
+		slog.Info("secret already present", "name", name)
+		return nil
+	}
+	if status != http.StatusNotFound {
+		return fmt.Errorf("read %s: HTTP %d", name, status)
+	}
+	fields, err := generate()
+	if err != nil {
+		return err
+	}
+	_, status, err = c.request(ctx, "POST", path, map[string]any{"options": map[string]int{"cas": 0}, "data": fields})
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK && status != http.StatusNoContent {
+		return fmt.Errorf("create %s: HTTP %d", name, status)
+	}
+	slog.Info("secret created", "name", name)
+	return nil
+}
+
+func caPool(kind localca.KeyType) (map[string]string, error) {
+	ca, err := localca.GenerateCA("1", kind, 365*24*time.Hour)
+	if err != nil {
+		return nil, err
+	}
+	pool, err := localca.Marshal(&localca.ConcretePool{CAs: []*localca.CA{ca}, ActiveForSigning: "1"})
+	if err != nil {
+		return nil, err
+	}
+	cert, err := ca.TLSCertificateChainPEM()
+	if err != nil {
+		return nil, err
+	}
+	return map[string]string{"pool": string(pool), "ca.crt": string(cert)}, nil
+}
+
+func password() (map[string]string, error) {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		return nil, err
+	}
+	return map[string]string{"password": hex.EncodeToString(b), "username": "ax_substrate"}, nil
+}
+
+func bootstrap(ctx context.Context) error {
+	jwt, err := os.ReadFile("/var/run/secrets/kubernetes.io/serviceaccount/token")
+	if err != nil {
+		return err
+	}
+	c := &baoClient{base: "http://openbao.openbao.svc:8200", http: &http.Client{Timeout: 15 * time.Second}}
+	data, status, err := c.request(ctx, "POST", "auth/kubernetes/login", map[string]string{"role": "ax-bootstrap", "jwt": string(jwt)})
+	if err != nil {
+		return err
+	}
+	if status != 200 {
+		return fmt.Errorf("OpenBao login: HTTP %d", status)
+	}
+	var login struct {
+		Auth struct {
+			Token string `json:"client_token"`
+		} `json:"auth"`
+	}
+	if err := json.Unmarshal(data, &login); err != nil {
+		return err
+	}
+	c.token = login.Auth.Token
+	if c.token == "" {
+		return fmt.Errorf("OpenBao login returned no token")
+	}
+	defer func() {
+		revokeCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 10*time.Second)
+		defer cancel()
+		_, status, err := c.request(revokeCtx, "POST", "auth/token/revoke-self", nil)
+		if err != nil || status != 204 {
+			slog.Error("temporary token revocation failed", "status", status)
+		}
+	}()
+	for _, name := range []string{"actor-id-ca-pool", "service-dns-ca-pool", "pod-identity-ca-pool", "egress-mitm-ca-pool"} {
+		kind := localca.KeyTypeED25519
+		if name == "egress-mitm-ca-pool" {
+			kind = localca.KeyTypeECDSAP256
+		}
+		if err := c.ensure(ctx, "ax-"+name, func() (map[string]string, error) { return caPool(kind) }); err != nil {
+			return err
+		}
+	}
+	if err := c.ensure(ctx, "ax-actor-id-jwt-pool", func() (map[string]string, error) {
+		authority, err := localjwtauthority.GenerateECDSAP256Authority("1")
+		if err != nil {
+			return nil, err
+		}
+		data, err := localjwtauthority.Marshal(&localjwtauthority.ConcretePool{Authorities: []*localjwtauthority.Authority{authority}, ActiveForSigning: "1"})
+		return map[string]string{"pool": string(data)}, err
+	}); err != nil {
+		return err
+	}
+	for _, name := range []string{"ax-postgres", "ax-valkey-password"} {
+		if err := c.ensure(ctx, name, password); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func main() {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	if err := bootstrap(ctx); err != nil {
+		slog.Error("AX bootstrap failed", "error", err)
+		os.Exit(1)
+	}
+	slog.Info("AX secrets ready")
+}
