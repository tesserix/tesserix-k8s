@@ -0,0 +1,42 @@
+package substrate
+
+import (
+	"context"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"testing"
+)
+
+type gatewayPolicyClient struct {
+	ateapipb.ControlClient
+	request *ateapipb.CreateActorEgressPolicyRequest
+	exists  bool
+}
+
+func (m *gatewayPolicyClient) CreateActorEgressPolicy(ctx context.Context, req *ateapipb.CreateActorEgressPolicyRequest, opts ...grpc.CallOption) (*ateapipb.EgressPolicy, error) {
+	m.request = req
+	if m.exists {
+		return nil, status.Error(codes.AlreadyExists, "exists")
+	}
+	return req.EgressPolicy, nil
+}
+func TestGatewayPolicyAllowsOnlyConfiguredGateway(t *testing.T) {
+	t.Setenv("AX_MODEL_GATEWAY_URL", "http://ai-gateway.agentgateway-system.svc.cluster.local:8080/vertex")
+	m := &gatewayPolicyClient{}
+	c := &Client{control: m}
+	for _, exists := range []bool{false, true} {
+		m.exists = exists
+		if err := c.ensureGatewayPolicy(context.Background(), "team-a", "task-a"); err != nil {
+			t.Fatal(err)
+		}
+		p := m.request.EgressPolicy
+		if m.request.Actor.Atespace != "team-a" || m.request.Actor.Name != "task-a" || p.Metadata.Atespace != "team-a" || p.Metadata.Name != "default" {
+			t.Fatal("incorrect policy scope")
+		}
+		if len(p.Rules) != 1 || len(p.Rules[0].GetHostnames().GetPatterns()) != 1 || p.Rules[0].GetHostnames().GetPatterns()[0] != "ai-gateway.agentgateway-system.svc.cluster.local" {
+			t.Fatal("policy permits unintended destinations")
+		}
+	}
+}
