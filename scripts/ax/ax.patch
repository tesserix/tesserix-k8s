+
+package server
+
+import (
+	"context"
+	"errors"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestReadinessFailsClosed(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name  string
+		ready func(context.Context) error
+		want  int
+	}{
+		{"unconfigured", nil, 503},
+		{"dependency unavailable", func(context.Context) error { return errors.New("private dependency detail") }, 503},
+		{"healthy", func(context.Context) error { return nil }, 200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			s := NewServer(nil, Options{Readiness: tc.ready})
+			rec := httptest.NewRecorder()
+			s.Handler().ServeHTTP(rec, httptest.NewRequest("GET", "/readyz", nil))
+			if rec.Code != tc.want {
+				t.Fatalf("status=%d; want %d", rec.Code, tc.want)
+			}
+			if rec.Body.String() == "private dependency detail" {
+				t.Fatal("readiness leaked dependency error")
+			}
+		})
+	}
+}
