index 0000000..9d0abc1
--- /dev/null
+++ b/cmd/ax-task-runner/test_antigravity_gateway.py
@@ -0,0 +1,53 @@
+import asyncio
+import importlib.util
+import os
+from pathlib import Path
+import sys
+import types
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location('bootstrap', Path(__file__).with_name('antigravity_bootstrap.py'))
+bootstrap = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(bootstrap)
+
+
+class GatewayConfigTest(unittest.TestCase):
+    def test_gateway_uses_scoped_vertex_endpoint_without_key(self):
+        captured = {}
+        class Value:
+            def __init__(self, **kwargs):
+                self.__dict__.update(kwargs)
+        class Response:
+            async def text(self):
+                return 'gateway-ok'
+        class Agent:
+            def __init__(self, config):
+                captured['config'] = config
+            async def __aenter__(self):
+                return self
+            async def __aexit__(self, *args):
+                pass
+            async def chat(self, prompt):
+                return Response()
+        sdk = types.ModuleType('google.antigravity')
+        sdk.Agent, sdk.CapabilitiesConfig, sdk.LocalAgentConfig = Agent, Value, Value
+        sdk.ModelTarget, sdk.VertexEndpoint = Value, Value
+        sdk.ModelType = types.SimpleNamespace(TEXT="text", IMAGE="image")
+        sdk.BuiltinTools = types.SimpleNamespace(GENERATE_IMAGE="generate_image")
+        hooks = types.ModuleType('google.antigravity.hooks')
+        hooks.policy = types.SimpleNamespace(workspace_only=lambda _: [], allow_all=lambda: None)
+        env = {'AX_MODEL_GATEWAY_URL': 'http://gateway/vertex', 'AX_MODEL_NAME': 'gemini-2.5-flash', 'AX_VERTEX_PROJECT': 'test-project', 'AX_VERTEX_LOCATION': 'global'}
+        with patch.dict(os.environ, env, clear=True), patch.dict(sys.modules, {'google': types.ModuleType('google'), 'google.antigravity': sdk, 'google.antigravity.hooks': hooks}):
+            asyncio.run(bootstrap.run_bootstrap('write a marker', '/workspace', ''))
+        cfg = captured['config']
+        self.assertEqual(cfg.model.endpoint.base_url, 'http://gateway/vertex')
+        self.assertEqual(cfg.model.endpoint.project, 'test-project')
+        self.assertEqual(cfg.model.name, 'gemini-2.5-flash')
+        self.assertFalse(hasattr(cfg, 'api_key'))
+        self.assertEqual(cfg.model.types, ["text", "image"])
+        self.assertEqual(cfg.capabilities.disabled_tools, ["generate_image"])
+
+
+if __name__ == '__main__':
+    unittest.main()
