diff --git a/internal/model/gateway_test.go b/internal/model/gateway_test.go
new file mode 100644
index 0000000..b97f849
--- /dev/null
+++ b/internal/model/gateway_test.go
@@ -0,0 +1,51 @@
+package model
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestGatewayUsesNativeVertexPathWithoutProviderKey(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		want := "/vertex/v1/projects/test-project/locations/global/publishers/google/models/gemini-2.5-flash:generateContent"
+		if r.URL.Path != want {
+			t.Errorf("path = %s, want %s", r.URL.Path, want)
+		}
+		if r.URL.Query().Has("key") || r.Header.Get("Authorization") != "" {
+			t.Error("gateway request leaked provider authentication")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"candidates":[{"content":{"parts":[{"text":"gateway-ok"}]}}]}`))
+	}))
+	defer server.Close()
+	t.Setenv("AX_MODEL_GATEWAY_URL", server.URL+"/vertex")
+	t.Setenv("AX_VERTEX_PROJECT", "test-project")
+	t.Setenv("AX_VERTEX_LOCATION", "global")
+	t.Setenv("AX_MODEL_NAME", "gemini-2.5-flash")
+	_, errDefault := NewClient(DefaultConfig()).Generate(context.Background(), &GenerateRequest{Prompt: "test default"})
+	if errDefault != nil {
+		t.Fatal(errDefault)
+	}
+	c := NewClient(Config{})
+	got, err := c.Generate(context.Background(), &GenerateRequest{Prompt: "test"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Content != "gateway-ok" {
+		t.Fatalf("response = %q", got.Content)
+	}
+}
+
+func TestGatewayFailureDoesNotSynthesizeSuccess(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusForbidden) }))
+	defer server.Close()
+	t.Setenv("AX_MODEL_GATEWAY_URL", server.URL)
+	t.Setenv("AX_VERTEX_PROJECT", "test-project")
+	t.Setenv("AX_VERTEX_LOCATION", "global")
+	_, err := NewClient(Config{}).Generate(context.Background(), &GenerateRequest{Prompt: "test"})
+	if err == nil {
+		t.Fatal("gateway failure was reported as successful inference")
+	}
+}
